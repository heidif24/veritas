{
  "expo": {
    "name": "Veritas",
    "slug": "veritas",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "veritas",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.veritas.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0ea5e9"
      },
      "package": "io.veritas.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
